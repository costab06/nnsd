echo "Creating directory structure /opt/neural"mkdir -p /opt/neural/binmkdir -p /opt/neural/confmkdir -p /opt/neural/tmpmkdir -p /opt/neural/datamkdir -p /opt/neural/logsecho "Copying nnsd to /opt/neural/bin"cp ./nnsd /opt/neural/binchown root:bin /opt/neural/bin/nnsdchmod 755 /opt/neural/bin/nnsdcp ./start_nnsd /opt/neural/bincp ./kill_nnsd /opt/neural/binecho "Creating /opt/neural/conf/nnsd.conf"echo `hostname` > /opt/neural/conf/nnsd.conf